<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="sulu_redirect.subscriber.entity"
                 class="Sulu\Bundle\RedirectBundle\GoneSubscriber\GoneEntitySubscriber">
            <argument type="service" id="sulu_route.route_repository"/>

            <tag name="doctrine.event_listener" event="preRemove" method="preRemove"/>
            <tag name="doctrine.event_listener" event="postFlush" method="postFlush" priority="10"/>
            <tag name="doctrine.event_listener" event="onClear" method="onClear"/>
            <tag name="kernel.reset" method="reset"/>
        </service>
    </services>
</container>
