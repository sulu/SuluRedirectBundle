<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="sulu_redirect.routing.loader"
                 class="Sulu\Bundle\RedirectBundle\Routing\RedirectRouteCollectionLoader">
            <argument type="service" id="sulu.repository.redirect_route"/>

            <tag name="sulu_route.route_collection_for_request_loader" priority="5"/>
            <tag name="sulu.context" context="website"/>
        </service>

        <service id="sulu_redirect.controller.redirect"
                 class="Sulu\Bundle\RedirectBundle\Controller\WebsiteRedirectController" public="true">
            <tag name="sulu.context" context="website"/>
        </service>
    </services>
</container>
